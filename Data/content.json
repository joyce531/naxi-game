	"dongba": {
	  "title": "图画会说话",
	  "book_texture": "res://Assets/culture_book/book/open_book.png",
	  "page_turn_sfx": "res://Assets/culture_book/audio/page_turn.ogg",
	  "start_button": "开始识字",
	  "spreads": [
		{
		  "title": "图画会说话",
		  "body": "东巴文 · 写在图画里的文化记忆\n\n翻开书页，认识一种至今仍令人着迷的古老文字。",
		  "illustration": "res://Assets/vn/decorations/deco_dongba_painting.png",
		  "caption": "东巴文装饰画",
		  "layout": "image_right"
		},
		{
		  "title": "一笔一画，皆有形",
		  "body": "人、鸟、山川、器物……都可以成为表达意义的线索。\n\n东巴文具有鲜明的图画象形特征。读懂一个符号，有时就像读懂一幅小小的画。",
		  "illustration": "res://Assets/dongba/sentence/dongba_sentence_01.png",
		  "caption": "人、山、水、火、太阳等东巴文字形",
		  "layout": "image_left"
		},
		{
		  "title": "东巴文 × 甲骨文",
		  "body": "东巴文与甲骨文都具有鲜明的象形特征，因此研究者常将二者放在一起比较。\n\n但东巴文并不是由甲骨文直接演变而来的。\n\n它们为我们观察文字如何从“形象”走向“符号”，提供了不同的珍贵材料。",
		  "illustration": "",
		  "caption": "",
		  "layout": "text_only"
		},
		{
		  "title": "一部写在古籍里的文化记忆",
		  "body": "大量东巴文保存在东巴古籍之中。\n\n一页页古籍不仅留下文字，也保存着纳西族关于自然、社会、信仰与生活的文化记忆。",
		  "illustration": "res://Assets/culture_book/illustrations/dongba/dongba_manuscript.png",
		  "caption": "",
		  "layout": "image_left"
		},
		{
		  "title": "从丽江，到世界记忆",
		  "body": "2003年，纳西东巴古籍文献被列入联合国教科文组织《世界记忆名录》。\n\n今天，这些古老文字已经不仅属于一座古城，也成为值得共同珍视的人类文化记忆。\n\n现在，你能从这些“图画”中读懂多少？",
		  "illustration": "",
		  "caption": "",
		  "layout": "text_only"
		}
	  ]
	},
	"music": {
	  "title": "一江流水，一曲古乐",
	  "book_texture": "res://Assets/culture_book/book/open_book.png",
	  "page_turn_sfx": "res://Assets/culture_book/audio/page_turn.ogg",
	  "start_button": "开始聆听",
	  "spreads": [
		{
		  "title": "一江流水，一曲古乐",
		  "body": "当文字记录记忆，音乐保存情感。",
		  "illustration": "",
		  "caption": "",
		  "layout": "text_only"
		},
		{
		  "title": "听见丽江的时间",
		  "body": "在丽江长期的历史与文化交流中，不同的音乐传统在这里流传、融合。\n\n今天人们所说的“纳西古乐”中，洞经音乐与白沙细乐是两个重要而又不同的传统。",
		  "illustration": "",
		  "caption": "",
		  "layout": "text_only"
		},
		{
		  "title": "洞经音乐",
		  "body": "庄重 · 礼仪 · 秩序\n\n洞经音乐与道教经典及礼仪音乐传统关系密切。传入丽江后，它又不断融入当地音乐元素，逐渐形成具有地方特色的音乐传统。",
		  "illustration": "res://Assets/culture_book/illustrations/music/dongjing_performance.png",
		  "caption": "",
		  "layout": "image_left"
		},
		{
		  "title": "乐器中的古老回声",
		  "body": "洞经音乐的演奏中，可以听见吹管、拉弦、弹拨与打击乐器共同形成丰富的声响。\n\n苏古笃、波伯、曲项琵琶等乐器，也体现了丽江音乐长期交流与本土化的痕迹。",
		  "illustration": "res://Assets/culture_book/illustrations/music/naxi_instruments.png",
		  "caption": "",
		  "layout": "image_right"
		},
		{
		  "title": "白沙细乐",
		  "body": "哀婉 · 追思 · 低回\n\n白沙细乐与祭奠、送葬和追思传统有着密切联系。它的音乐常呈现缠绵、低回、如泣如诉的情感色彩。",
		  "illustration": "res://Assets/culture_book/illustrations/music/baisha_performance.png",
		  "caption": "",
		  "layout": "image_left"
		},
		{
		  "title": "听得出它们的不同吗？",
		  "body": "洞经音乐：庄重 · 礼仪 · 秩序\n\n白沙细乐：哀婉 · 追思 · 低回\n\n横笛是白沙细乐的重要主奏乐器之一，此外还使用直笛、波伯、曲项琵琶、筝、苏古笃、二簧、胡琴等乐器。\n\n别只靠一种乐器判断——接下来，用耳朵寻找答案。",
		  "illustration": "",
		  "caption": "",
		  "layout": "text_only"
		}
	  ]
	},
	"dance": {
	  "title": "围成一圈，把生活跳进舞步",
	  "book_texture": "res://Assets/culture_book/book/open_book.png",
	  "page_turn_sfx": "res://Assets/culture_book/audio/page_turn.ogg",
	  "start_button": "开始学打跳",
	  "spreads": [
		{
		  "title": "围成一圈，把生活跳进舞步",
		  "body": "纳西民间打跳",
		  "illustration": "",
		  "caption": "",
		  "layout": "text_only"
		},
		{
		  "title": "大家一起跳",
		  "body": "在丽江部分地区，以笛子或葫芦笙等伴奏的群众舞蹈常被称为“打跳”。\n\n音乐响起，参与者围在一起，共同进入舞步与节奏。",
		  "illustration": "res://Assets/culture_book/illustrations/dance/datiao_circle.png",
		  "caption": "",
		  "layout": "image_left"
		},
		{
		  "title": "民间打跳 ≠ 东巴法仪舞蹈",
		  "body": "本关学习的是群众共同参与的民间“打跳”。\n\n它与东巴在特定宗教仪式中进行的法仪舞蹈并不是同一个概念。\n\n所以这一次，我们不是观看仪式，而是加入舞圈。",
		  "illustration": "",
		  "caption": "",
		  "layout": "text_only"
		},
		{
		  "title": "生活在脚下",
		  "body": "打跳中可以看到踏步、踢腿、甩手、摇摆等身体动作。\n\n不同地区和舞种形成了不同的动作组合，舞者在共同节奏中不断配合。",
		  "illustration": "res://Assets/culture_book/illustrations/dance/datiao_step.png",
		  "caption": "",
		  "layout": "image_right"
		},
		{
		  "title": "身体里的文化记忆",
		  "body": "打跳强调参与和配合。踏步、踢腿、摇摆与队形变化，需要舞者不断协调自己的身体与节奏。\n\n学习传统舞步，不只是“看见”一种文化，也是亲自加入它、体验它。\n\n接下来，不只是看——跟着口诀，把舞步真正跳起来。",
		  "illustration": "res://Assets/culture_book/illustrations/dance/datiao_together.png",
		  "caption": "",
		  "layout": "image_left"
		}
	  ]
	}
